title "Tour Energy Gel"
type sprite
size 64x64
fps 10
palette cyber
outline #090619
light -0.5,-0.7

part shadow ramp=obsidian z=-5 pivot=32,56
  box 32,56 12,2.5 r=1.5 step=0

part pouch ramp=plasma z=0 pivot=32,32 dither=bayer2
  box 32,34 12,15 r=4.0
  box 32,16 5,4 r=1.5 op=smin k=2.0
  capsule 22,22 42,22 r=2.5 op=smin k=1.5

part label ramp=gold z=2 pivot=32,34
  box 32,35 8,7 r=2.0
  poly 34,27 27,35 32,35 30,43 37,34 32,34

part glint ramp=bone z=4 pivot=32,32
  pixel 24,23 w=2 h=6 step=3
  pixel 24,21 w=2 h=2 step=3

tag idle frames=4 loop=pingpong
  pose pouch dy=sin(2.0) squash=cos(0.08)
  pose label dy=sin(2.0)
  pose glint dy=sin(2.0)
  pose shadow squash=cos(0.08)

tag spin frames=4 loop=loop
  pose pouch dy=sin(2.5) squash=sin(0.12)
  pose label dy=sin(2.5)
  pose glint dy=sin(2.5)
