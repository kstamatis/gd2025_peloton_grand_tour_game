title "Team Bidon Water Bottle"
type sprite
size 64x64
fps 10
palette genesis
outline #0F0C1C
light -0.5,-0.7

part shadow ramp=obsidian z=-5 pivot=32,56
  box 32,56 11,2.5 r=1.5 step=0

part bottle ramp=water z=0 pivot=32,34 dither=bayer2
  box 32,37 11,14 r=5.0
  box 32,21 8,3 r=2.0 op=smin k=1.5

part cap ramp=crimson z=2 pivot=32,16
  box 32,16 9,3.5 r=2.0
  circle 32,11 r=3.0

part stripe ramp=gold z=3 pivot=32,36
  box 32,36 11,4 r=1.0
  pixel 25,28 w=2 h=12 step=3 ramp=bone

tag idle frames=4 loop=pingpong
  pose bottle dy=sin(2.0) rot=sin(4.0)
  pose cap dy=sin(2.0) rot=sin(4.0)
  pose stripe dy=sin(2.0) rot=sin(4.0)

tag spin frames=4 loop=loop
  pose bottle dy=sin(2.5) squash=cos(0.10)
  pose cap dy=sin(2.5)
  pose stripe dy=sin(2.5)
