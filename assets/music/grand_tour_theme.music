title "Peloton Grand Tour - Maillot Jaune Breakaway"
type song
tempo allegro 136
time 4/4

inst brass_lead    wave=ym2612_brass      vol=0.16 pan=-0.20 adsr=0.005,0.14,0.82,0.09 vib=5.2,1.60 lpf=0.45
inst brass_double  wave=ym2612_brass      gm=synth_brass_1 vol=0.12 pan=0.22 adsr=0.006,0.14,0.80,0.09 vib=5.0,1.40 lpf=0.42
inst epiano_comp   wave=ym2612_epiano     vol=0.13 pan=-0.28 adsr=0.004,0.15,0.78,0.10 lpf=0.40
inst strings_pad   wave=ym2612_strings    vol=0.10 pan=0.26 adsr=0.030,0.18,0.84,0.14 lpf=0.35
inst psg_sprint    wave=psg_square        vol=0.065 pan=-0.12 adsr=0.003,0.12,0.82,0.08 vib=5.6,2.20 lpf=0.44
inst psg_cadence   wave=psg_arp           vol=0.060 pan=0.30 adsr=0.002,0.10,0.76,0.06 lpf=0.42
inst tour_bell     wave=ym2612_bell       vol=0.055 pan=0.24 adsr=0.002,0.14,0.75,0.10 lpf=0.55
inst bass_drive    wave=ym2612_slap_bass  vol=0.24 lpf=0.065
inst sub_anchor    wave=sub_bass          vol=0.25 lpf=0.038
inst drums         wave=kick              vol=0.22 pan=0.00

# 4-bar chord cycle: Bar 1 = Am, Bar 2 = F, Bar 3 = C, Bar 4 = G (32 bars = 8 cycles)
pattern brass_intro =
  A4:2 E5:8. C5 A4:8 | F4:2 C5:8. A4 F4:8 | G4:2 E5:8. C5 G4:8 | D5:1 |
  A4:2 E5:8. C5 E5:8 | F5:2 C5:8. A4 C5:8 | G5:2 E5:8. C5 E5:8 | D5:2. B4:4 |

pattern brass_themeA =
  (A4:8 E5:8.*2 E5:8 C5 A4:8 R:16 E5:16 | F4:8 C5:8.*2 C5:8 A4 F4:8 R:16 C5:16 |
   G4:8 E5:8.*2 E5:8 C5 G4:8 R:16 E5:16 | G4:8 D5:8.*2 D5:4 B4:4 |)*2

pattern brass_themeB =
  (C5:2 E5:4 A5 | F5:2 C5:4 A4 | E5:2 G5:4 C5 | D5:2. B4:4 |)*2

pattern brass_outro =
  A4:1~1 | C5:1~1 | A4:1~1 | G4:1~1 |

pattern epiano_cycle =
  A3:8 C4:8.*2 E4:8 C4 A3:8 C4 | F3:8 A3:8.*2 C4:8 A3 F3:8 A3 |
  C4:8 E4:8.*2 G4:8 E4 C4:8 E4 | G3:8 B3:8.*2 D4:8 B3 G3:8 B3 |
pattern epiano_full = epiano_cycle*6 | A3:1 | F3:1 | C4:1 | G3:1 | A3:1 | F3:1 | C4:1 | G3:1 |

pattern pad_cycle =
  E4:1 | C4:1 | E4:1 | D4:1 |
pattern pad_full = pad_cycle*8

pattern psg_silence8 = (R:1~1 |)*4
pattern psg_melodyA =
  (E5:2 C5:8. A4 E5:8 | F5:2 C5:8. A4 C5:8 | G5:2 E5:8. C5 G4:8 | B4:2. G4:4 |)*2
pattern psg_melodyB =
  (A5:2 E5:4 C5 | F5:2. C5:4 | G5:2 E5:4 C5 | D5:1 |)*2
pattern psg_full = psg_silence8 psg_melodyA psg_melodyB psg_silence8

pattern arp_cycle =
  (A3 E4 A4 E4):16*4 | (F3 C4 F4 C4):16*4 | (C4 G4 C5 G4):16*4 | (G3 D4 G4 D4):16*4 |
pattern arp_full = (R:1~1 |)*2 arp_cycle*6 (R:1~1 |)*2

pattern bell_full =
  (R:1~1 |)*8
  (A5:2 R:2 | F5:2 R:2 | G5:2 R:2 | D5:2 R:2 |)*2
  (R:1~1 |)*4

pattern bass_intro =
  (A1:8.*2 A1:4 A1:4. | F1:8.*2 F1:4 F1:4. | C2:8.*2 C2:4 C2:4. | G1:8.*2 G1:4 G1:4. |)*2

pattern bass_peloton =
  ((A1 A2):16*8 | (F1 F2):16*8 | (C2 C3):16*8 | (G1 G2):16*8 |)*4

pattern bass_outro =
  (A1:1 | F1:1 | C2:1 | G1:1 |)*2

pattern bass_full = bass_intro bass_peloton bass_outro

pattern sub_cycle =
  A1:1 | F1:1 | C2:1 | G1:1 |
pattern sub_full = sub_cycle*8

pattern drum_bar  = kick:8. kick:16 snare:8 kick:4 kick:8 snare:4 |
pattern drum_fill = kick:8. kick:16 snare:8 kick:4 kick:8 (snare*2 tom_mid kick):16 |
pattern drum_full =
  (R:1 |)*3 R:2. (snare*3 kick):16 |
  (drum_bar*3 drum_fill)*6
  (R:1 |)*4

track ch01_brass_lead   brass_lead:   brass_intro brass_themeA brass_themeB brass_outro
track ch02_brass_double brass_double: brass_intro brass_themeA brass_themeB brass_outro
track ch03_epiano_comp  epiano_comp:  epiano_full
track ch04_strings_pad  strings_pad:  pad_full
track ch05_psg_sprint   psg_sprint:   psg_full
track ch06_psg_cadence  psg_cadence:  arp_full
track ch07_tour_bell    tour_bell:    bell_full
track ch08_bass_drive   bass_drive:   bass_full
track ch09_sub_anchor   sub_anchor:   sub_full
track ch10_drums        drums:        drum_full
